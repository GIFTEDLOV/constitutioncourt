{
  "name": "constitutioncourt-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ConstitutionCourt — governance-compliance adjudicator. Read-only case viewer plus case creation.",
  "scripts": {
    "dev": "vite --port 3100 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3100 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "e2e:encoding": "node e2e/encoding.mjs",
    "a11y": "node e2e/a11y.mjs",
    "sweep": "node e2e/sweep.mjs",
    "repro": "node e2e/reproducibility.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.12.1",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "puppeteer": "25.3.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.7",
    "vitest": "3.2.4"
  }
}
